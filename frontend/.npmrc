node-linker=hoisted
shamefully-hoist=true
package-import-method=copy

# pnpm v11+ overrides (previously under package.json "pnpm.overrides")
# see: https://pnpm.io/package_json#dependenciesmetainjected
# NOTE: overrides are declared via package.json "overrides" top-level key (kept there for
# package-manager portability); hoisted/copy settings here fix exFAT lack of symlink support.
