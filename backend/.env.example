# MongoDB Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=interview_prep_simulator

# Groq Cloud API (LLM + Whisper STT)
GROQ_API_KEY=sk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# TTS Provider Configuration
TTS_PROVIDER=edge-tts
# ElevenLabs (optional, if TTS_PROVIDER=elevenlabs):
ELEVENLABS_API_KEY=sk_your_elevenlabs_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Tavus (AI video interviewer — optional, for Module 2 video mode)
TAVUS_API_KEY=tv_your_tavus_api_key
TAVUS_BASE_URL=https://tavusapi.com/v2
TAVUS_WORKSPACE_ID=workspace_xxxxxxxxxxxx
TAVUS_PAL_ID=pal_xxxxxxxxxxxx
TAVUS_PERSONA_ID=persona_xxxxxxxxxxxx
TAVUS_FACE_ID=face_xxxxxxxxxxxx
TAVUS_WEBHOOK_SECRET=tavus_webhook_secret_here

# Web Grounding Provider
WEB_GROUNDING_PROVIDER=duckduckgo
# Tavily (optional, if WEB_GROUNDING_PROVIDER=tavily):
TAVILY_API_KEY=tvly-your_tavily_key

# HuggingFace (optional fallback for STT/TTS/analysis)
HUGGINGFACE_API_KEY=hf_your_huggingface_key

# Server Config
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# CORS / Frontend Integration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
FRONTEND_BASE_URL=http://localhost:3000

# Resilience Tunables
WEB_GROUNDING_TIMEOUT_SECONDS=8
VOICE_PIPELINE_TIMEOUT_SECONDS=30
WEBSOCKET_GRACE_PERIOD_SECONDS=60
WEBSOCKET_IDLE_TIMEOUT_SECONDS=300
MAX_AUDIO_BUFFER_MB=64

# Resume Parsing (Module 1 onboarding)
MAX_RESUME_SIZE_MB=10
ALLOWED_RESUME_EXTENSIONS=pdf,docx

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
WS_RATE_LIMIT_PER_MINUTE=120
